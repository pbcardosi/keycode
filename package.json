{
  "name": "keycode-ai",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "KeyCode — a free, local-first, bring-your-own-key coding agent.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "coding-agent",
    "cli",
    "terminal",
    "ollama",
    "byok"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "keycode": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "npm run build && node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:acceptance": "npm run build && vitest run tests/acceptance",
    "validate:spec": "node scripts/validate-spec.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:extension": "node scripts/validate-extension.mjs",
    "pack:smoke": "npm run build && node scripts/pack-smoke.mjs",
    "extension:smoke": "node scripts/extension-smoke.mjs",
    "browser:smoke": "npm run build && node scripts/browser-smoke.mjs",
    "release:check": "npm run verify && npm run pack:smoke && npm publish --dry-run",
    "release:checksums": "node scripts/checksums.mjs",
    "prepack": "npm run build",
    "verify": "npm run validate:spec && npm run validate:package && npm run validate:extension && npm run typecheck && npm test"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "ink": "^6.0.0",
    "playwright-core": "^1.65.1",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pbcardosi/keycode.git"
  },
  "homepage": "https://github.com/pbcardosi/keycode#readme",
  "bugs": {
    "url": "https://github.com/pbcardosi/keycode/issues"
  }
}
