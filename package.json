{
  "name": "keycode-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free, local-first, bring-your-own-key coding agent.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "keycode": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:acceptance": "npm run build && vitest run tests/acceptance",
    "validate:spec": "node scripts/validate-spec.mjs",
    "verify": "npm run validate:spec && npm run typecheck && npm test"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "ink": "^6.0.0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
